require 'bundler/setup'
require 'dotenv'
require 'sequel'
require 'rake'
require 'redis'
require 'oj'

namespace :containers do
  desc 'Populate container cache from postgres'
  task :cache_populate do
    Dotenv.load
    db = Sequel.connect(ENV['PG_URL'])
    redis = Redis.new(url: ENV['REDIS_URL'])
    containers_key = 'n2o:containers'
    containers_temp_key = 'n2o:containers:temp'

    sql = <<-SQL
  SELECT containers.slug AS container_slug, containers.cid, hosts.slug AS host_slug, hosts.ip_address, hosts.freighterd_port, hosts.secret
  FROM containers INNER JOIN hosts ON containers.host_id = hosts.id
  WHERE containers.terminated_at IS NULL AND containers.user_id = 73 LIMIT 10
SQL

    db.fetch(sql) do |row|
      redis.hset(containers_temp_key, row[:container_slug], Oj.dump(row, mode: :compat))
    end
    redis.rename(containers_temp_key, containers_key)
  end
end
