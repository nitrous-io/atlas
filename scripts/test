#!/usr/local/opt/rbenv/shims/ruby -w

require 'json'
require 'open3'

def run_redis_command(command)
  system "redis-cli -h 127.0.0.1 -n 1 -p 16379 #{command}"
end

def run_command(command)
  exit(1) unless system command
end

def get_output_from_command(command)
  return `#{command}`.chop
end

def add_container(server_name, freighterd_port, options = {})
  slug = options.fetch(:slug, server_name)
  cid = get_output_from_command "docker ps | grep atlas_#{server_name} | awk '{print $1}'"
  server_ip = get_output_from_command "docker inspect --format '{{ .NetworkSettings.IPAddress }}' #{cid}"
  data = {
    container_slug: server_name,
    ip_address: server_ip,
    freighterd_port: freighterd_port
  }
  run_redis_command "hset n2o:containers #{slug} '#{JSON.dump(data)}'"
end

run_command 'docker-compose -f docker-compose-test.yml stop'
run_command 'docker-compose -f docker-compose-test.yml up -d proxy redis server0 server1 server2'

run_redis_command 'flushdb'
add_container 'server0', 65333
add_container 'server1', 65334
add_container 'server2', 65333

run_command "docker-compose -f docker-compose-test.yml run test \"busted\""
run_command "docker-compose -f docker-compose-test.yml run test \"rspec\""
