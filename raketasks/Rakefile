require 'bundler/setup'
require 'dotenv'
require 'sequel'
require 'rake'
require 'redis'
require 'oj'

namespace :containers do
  desc 'Populate container cache from postgres'
  task :update_cache do
    Dotenv.load
    db = Sequel.connect(ENV['NITROUS_PG_URL'])
    redis = Redis.new(host: ENV['REDIS_HOST'], port: ENV['REDIS_PORT'], db: ENV['REDIS_DATABASE'])
    containers_key = 'n2o:containers'
    containers_temp_key = 'n2o:containers:temp'

    sql = <<-SQL
  SELECT containers.slug AS container_slug, containers.cid, hosts.slug AS host_slug, hosts.ip_address, hosts.freighterd_port, hosts.secret, containers.port_mappings
  FROM containers INNER JOIN hosts ON containers.host_id = hosts.id
  WHERE containers.terminated_at IS NULL
SQL

    count = 0
    db.fetch(sql) do |row|
      redis.hset(containers_temp_key, row[:container_slug], Oj.dump(row, mode: :compat))
      count+=1
    end
    redis.rename(containers_temp_key, containers_key) if count > 0
  end
end

namespace :hosts do
  desc 'Populate hosts cache from postgres'
  task :update_cache do
    Dotenv.load
    db = Sequel.connect(ENV['NITROUS_PG_URL'])
    redis = Redis.new(host: ENV['REDIS_HOST'], port: ENV['REDIS_PORT'], db: ENV['REDIS_DATABASE'])
    hosts_key = 'n2o:hosts'
    hosts_temp_key = 'n2o:hosts:temp'

    sql = <<-SQL
  SELECT slug, ip_address, freighterd_port
  FROM hosts
  WHERE terminated_at IS NULL
  AND state = 'running'
  AND COALESCE(ip_address, '') != ''
    SQL

    count = 0
    db.fetch(sql) do |row|
      redis.hset(hosts_temp_key, row[:slug], Oj.dump(row, mode: :compat))
      count += 1
    end

    redis.rename(hosts_temp_key, hosts_key) if count > 0
  end
end